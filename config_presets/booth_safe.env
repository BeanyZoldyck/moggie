# Judging-day stability preset: offline cloud path plus conservative CV settings.
MOGGIE_ENV=production
MOGGIE_FULLSCREEN=true
MOGGIE_ENABLE_REDIS_LEADERBOARD_CACHE=false
MOGGIE_ENABLE_IMAGE_GENERATION=false
MOGGIE_ENABLE_MIDJOURNEY=false
MOGGIE_ENABLE_PIKA=false
MOGGIE_ENABLE_OVERSHOOT=false
MOGGIE_ENABLE_LLM_LABELS=false
MOGGIE_EMOJI_USE_CLOUD_VALIDATION=false
MOGGIE_SAVE_GENERATED_MEDIA=false
MOGGIE_CAMERA_WIDTH=640
MOGGIE_CAMERA_HEIGHT=480
MOGGIE_CV_WIDTH=320
MOGGIE_CV_HEIGHT=240
MOGGIE_CV_FPS=15
MOGGIE_CAMERA_RETRY_SECONDS=3
MOGGIE_IDLE_ATTRACT_ENABLED=true
